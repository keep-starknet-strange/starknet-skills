{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Normalized Audit Metadata",
  "type": "object",
  "required": [
    "audit_id",
    "project",
    "auditor",
    "date",
    "source_url",
    "repository",
    "scope_files",
    "finding_count"
  ],
  "properties": {
    "audit_id": { "type": "string", "minLength": 1 },
    "project": { "type": "string", "minLength": 1 },
    "auditor": { "type": "string", "minLength": 1 },
    "date": { "type": "string", "format": "date" },
    "source_url": { "type": "string", "minLength": 1 },
    "repository": { "type": "string", "minLength": 1 },
    "scope_files": { "type": "array", "items": { "type": "string" } },
    "finding_count": { "type": "integer", "minimum": 0 },
    "finding_label_semantics": {
      "type": "string",
      "enum": [
        "reported_findings_present",
        "report_declared_zero_findings",
        "not_yet_extracted"
      ]
    },
    "negative_label_scope": {
      "type": "string",
      "enum": ["none", "audit_scope_only", "verified_code_unit"]
    },
    "safety_claim": {
      "type": "string",
      "enum": ["not_proven", "bounded_by_evidence"]
    },
    "severity_counts": {
      "type": "object",
      "additionalProperties": { "type": "integer", "minimum": 0 }
    },
    "status_summary": {
      "type": "object",
      "additionalProperties": { "type": "integer", "minimum": 0 }
    },
    "notes": {
      "type": "string"
    }
  },
  "additionalProperties": false
}
